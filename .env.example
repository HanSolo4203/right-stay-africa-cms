# Supabase (client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side only — bypasses RLS; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used when registering Uplisting webhooks)
NEXT_PUBLIC_APP_URL=https://ops.rightstayafrica.com

# Uplisting integration (Settings → Connect → API)
UPLISTING_API_KEY=
# Optional override (default https://connect.uplisting.io)
# UPLISTING_API_URL=https://connect.uplisting.io

# Connect → Webhooks signing key (UUID). Used for HMAC when Uplisting sends
# x-uplisting-signature. Not sent at webhook registration.
UPLISTING_WEBHOOK_SECRET=

# Shared token appended as ?token= on the registered webhook URL.
# Fallback auth when signature headers are absent (Connect deliveries).
UPLISTING_WEBHOOK_TOKEN=

# Set to true temporarily to log webhook headers + truncated body (never the secret)
UPLISTING_WEBHOOK_DEBUG=false

# Sync / hooks / cron protection (must match each other)
SYNC_SECRET=
NEXT_PUBLIC_SYNC_SECRET=
